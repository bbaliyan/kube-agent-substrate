{
 "title": "Agent Substrate",
 "uid": "agent-substrate",
 "tags": [
  "agent-substrate"
 ],
 "schemaVersion": 39,
 "description": "Health of the Agent Substrate control plane: actors, workers, snapshots, router and API.",
 "graphTooltip": 1,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "1m",
 "editable": true,
 "templating": {
  "list": [
   {
    "name": "datasource",
    "label": "Data source",
    "type": "datasource",
    "query": "prometheus",
    "current": {}
   },
   {
    "name": "atespace",
    "label": "Atespace",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "refresh": 2,
    "query": {
     "query": "label_values(ate_actor_lifecycle_operation_duration_seconds_count, ate_template_atespace)",
     "refId": "atespace"
    },
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Ready workers",
   "description": "Worker pods that are ready, for all pools.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(max by (ate_workerpool_namespace, ate_workerpool_name)(ate_workerpool_ready_workers))",
     "legendFormat": "__auto",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     },
     "noValue": "no data"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Missing workers",
   "description": "Desired workers that are not ready. Above 0 for more than some minutes means a pool cannot start its pods.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(max by (ate_workerpool_namespace, ate_workerpool_name)(ate_workerpool_desired_workers)) - sum(max by (ate_workerpool_namespace, ate_workerpool_name)(ate_workerpool_ready_workers))",
     "legendFormat": "__auto",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "noValue": "no data"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Actor resumes",
   "description": "Resume operations in the time range, with and without an error.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(((increase(ate_actor_lifecycle_operation_duration_seconds_count{ate_template_atespace=~\"$atespace\",ate_actor_operation_name=\"resume\"}[$__range]) + (min_over_time(ate_actor_lifecycle_operation_duration_seconds_count{ate_template_atespace=~\"$atespace\",ate_actor_operation_name=\"resume\"}[$__range]) unless ate_actor_lifecycle_operation_duration_seconds_count{ate_template_atespace=~\"$atespace\",ate_actor_operation_name=\"resume\"} offset $__range)) or increase(ate_actor_lifecycle_operation_duration_seconds_count{ate_template_atespace=~\"$atespace\",ate_actor_operation_name=\"resume\"}[$__range]))) or vector(0)",
     "legendFormat": "__auto",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     },
     "noValue": "no data"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Resume time, p95",
   "description": "95th percentile of the successful resume operations in the time range. An estimate from histogram buckets.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.95, sum by (le)(((increase(ate_actor_lifecycle_operation_duration_seconds_bucket{ate_template_atespace=~\"$atespace\",ate_actor_operation_name=\"resume\",error_type=\"\"}[$__range]) + (min_over_time(ate_actor_lifecycle_operation_duration_seconds_bucket{ate_template_atespace=~\"$atespace\",ate_actor_operation_name=\"resume\",error_type=\"\"}[$__range]) unless ate_actor_lifecycle_operation_duration_seconds_bucket{ate_template_atespace=~\"$atespace\",ate_actor_operation_name=\"resume\",error_type=\"\"} offset $__range)) or increase(ate_actor_lifecycle_operation_duration_seconds_bucket{ate_template_atespace=~\"$atespace\",ate_actor_operation_name=\"resume\",error_type=\"\"}[$__range]))))",
     "legendFormat": "__auto",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 2,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     },
     "noValue": "no data"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Failed operations",
   "description": "Actor lifecycle operations that ended with an error in the time range.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(((increase(ate_actor_lifecycle_operation_duration_seconds_count{ate_template_atespace=~\"$atespace\",error_type!=\"\"}[$__range]) + (min_over_time(ate_actor_lifecycle_operation_duration_seconds_count{ate_template_atespace=~\"$atespace\",error_type!=\"\"}[$__range]) unless ate_actor_lifecycle_operation_duration_seconds_count{ate_template_atespace=~\"$atespace\",error_type!=\"\"} offset $__range)) or increase(ate_actor_lifecycle_operation_duration_seconds_count{ate_template_atespace=~\"$atespace\",error_type!=\"\"}[$__range]))) or vector(0)",
     "legendFormat": "__auto",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       }
      ]
     },
     "noValue": "no data"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Actor crashes",
   "description": "Actors that crashed in the time range.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(((increase(ate_actor_crashes_total{ate_template_atespace=~\"$atespace\"}[$__range]) + (min_over_time(ate_actor_crashes_total{ate_template_atespace=~\"$atespace\"}[$__range]) unless ate_actor_crashes_total{ate_template_atespace=~\"$atespace\"} offset $__range)) or increase(ate_actor_crashes_total{ate_template_atespace=~\"$atespace\"}[$__range]))) or vector(0)",
     "legendFormat": "__auto",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "noValue": "no data"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 7,
   "type": "row",
   "title": "Actor lifecycle",
   "collapsed": false,
   "panels": [],
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 1
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Operations",
   "description": "Lifecycle operations that ended in each step, by operation.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (ate_actor_operation_name)((((ate_actor_lifecycle_operation_duration_seconds_count{ate_template_atespace=~\"$atespace\"} - ate_actor_lifecycle_operation_duration_seconds_count{ate_template_atespace=~\"$atespace\"} offset $__interval) >= 0) or (ate_actor_lifecycle_operation_duration_seconds_count{ate_template_atespace=~\"$atespace\"} unless ate_actor_lifecycle_operation_duration_seconds_count{ate_template_atespace=~\"$atespace\"} offset $__interval) or (ate_actor_lifecycle_operation_duration_seconds_count{ate_template_atespace=~\"$atespace\"} < ate_actor_lifecycle_operation_duration_seconds_count{ate_template_atespace=~\"$atespace\"} offset $__interval))) > 0",
     "legendFormat": "{{ate_actor_operation_name}}",
     "refId": "A"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 10
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 80,
      "lineWidth": 1,
      "showPoints": "never",
      "spanNulls": false,
      "axisSoftMin": 0,
      "stacking": {
       "mode": "normal"
      },
      "axisSoftMax": 4
     },
     "color": {
      "mode": "palette-classic"
     },
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "interval": "1m"
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Failed operations, by operation and error",
   "description": "An empty panel is good. ResourceExhausted means that no worker had room.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (ate_actor_operation_name, error_type)((((ate_actor_lifecycle_operation_duration_seconds_count{ate_template_atespace=~\"$atespace\",error_type!=\"\"} - ate_actor_lifecycle_operation_duration_seconds_count{ate_template_atespace=~\"$atespace\",error_type!=\"\"} offset $__interval) >= 0) or (ate_actor_lifecycle_operation_duration_seconds_count{ate_template_atespace=~\"$atespace\",error_type!=\"\"} unless ate_actor_lifecycle_operation_duration_seconds_count{ate_template_atespace=~\"$atespace\",error_type!=\"\"} offset $__interval) or (ate_actor_lifecycle_operation_duration_seconds_count{ate_template_atespace=~\"$atespace\",error_type!=\"\"} < ate_actor_lifecycle_operation_duration_seconds_count{ate_template_atespace=~\"$atespace\",error_type!=\"\"} offset $__interval))) > 0",
     "legendFormat": "{{ate_actor_operation_name}}: {{error_type}}",
     "refId": "A"
    }
   ],
   "gridPos": {
    "x": 12,
    "y": 5,
    "w": 12,
    "h": 10
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 80,
      "lineWidth": 1,
      "showPoints": "never",
      "spanNulls": false,
      "axisSoftMin": 0,
      "stacking": {
       "mode": "normal"
      },
      "axisSoftMax": 4
     },
     "color": {
      "mode": "palette-classic"
     },
     "decimals": 0,
     "noValue": "No failed operation in this range"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "interval": "1m"
  },
  {
   "id": 10,
   "type": "table",
   "title": "Operation time",
   "description": "Successful operations in the time range. The percentiles are estimates from histogram buckets.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (ate_actor_operation_name)(((increase(ate_actor_lifecycle_operation_duration_seconds_count{ate_template_atespace=~\"$atespace\",error_type=\"\"}[$__range]) + (min_over_time(ate_actor_lifecycle_operation_duration_seconds_count{ate_template_atespace=~\"$atespace\",error_type=\"\"}[$__range]) unless ate_actor_lifecycle_operation_duration_seconds_count{ate_template_atespace=~\"$atespace\",error_type=\"\"} offset $__range)) or increase(ate_actor_lifecycle_operation_duration_seconds_count{ate_template_atespace=~\"$atespace\",error_type=\"\"}[$__range]))) > 0",
     "legendFormat": "__auto",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.5, sum by (le, ate_actor_operation_name)(((increase(ate_actor_lifecycle_operation_duration_seconds_bucket{ate_template_atespace=~\"$atespace\",error_type=\"\"}[$__range]) + (min_over_time(ate_actor_lifecycle_operation_duration_seconds_bucket{ate_template_atespace=~\"$atespace\",error_type=\"\"}[$__range]) unless ate_actor_lifecycle_operation_duration_seconds_bucket{ate_template_atespace=~\"$atespace\",error_type=\"\"} offset $__range)) or increase(ate_actor_lifecycle_operation_duration_seconds_bucket{ate_template_atespace=~\"$atespace\",error_type=\"\"}[$__range]))))",
     "legendFormat": "__auto",
     "refId": "B",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "histogram_quantile(0.95, sum by (le, ate_actor_operation_name)(((increase(ate_actor_lifecycle_operation_duration_seconds_bucket{ate_template_atespace=~\"$atespace\",error_type=\"\"}[$__range]) + (min_over_time(ate_actor_lifecycle_operation_duration_seconds_bucket{ate_template_atespace=~\"$atespace\",error_type=\"\"}[$__range]) unless ate_actor_lifecycle_operation_duration_seconds_bucket{ate_template_atespace=~\"$atespace\",error_type=\"\"} offset $__range)) or increase(ate_actor_lifecycle_operation_duration_seconds_bucket{ate_template_atespace=~\"$atespace\",error_type=\"\"}[$__range]))))",
     "legendFormat": "__auto",
     "refId": "C",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 15,
    "w": 12,
    "h": 10
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Count"
      },
      "properties": [
       {
        "id": "unit",
        "value": "short"
       },
       {
        "id": "decimals",
        "value": 0
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "ate_actor_operation_name": "Operation",
       "Value #A": "Count",
       "Value #B": "p50",
       "Value #C": "p95"
      }
     }
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Placement results",
   "description": "Results of the scheduler when it looks for a worker. no_capacity means that the pool is full.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (ate_scheduler_outcome)((((ate_scheduler_assignment_duration_seconds_count - ate_scheduler_assignment_duration_seconds_count offset $__interval) >= 0) or (ate_scheduler_assignment_duration_seconds_count unless ate_scheduler_assignment_duration_seconds_count offset $__interval) or (ate_scheduler_assignment_duration_seconds_count < ate_scheduler_assignment_duration_seconds_count offset $__interval))) > 0",
     "legendFormat": "{{ate_scheduler_outcome}}",
     "refId": "A"
    }
   ],
   "gridPos": {
    "x": 12,
    "y": 15,
    "w": 12,
    "h": 10
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 80,
      "lineWidth": 1,
      "showPoints": "never",
      "spanNulls": false,
      "axisSoftMin": 0,
      "stacking": {
       "mode": "normal"
      },
      "axisSoftMax": 4
     },
     "color": {
      "mode": "palette-classic"
     },
     "decimals": 0,
     "noValue": "No placement in this range"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "interval": "1m"
  },
  {
   "id": 12,
   "type": "row",
   "title": "Workers and actors",
   "collapsed": false,
   "panels": [],
   "gridPos": {
    "x": 0,
    "y": 25,
    "w": 24,
    "h": 1
   }
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Workers by state",
   "description": "idle has no actor. partial runs actors and has room. at_capacity is full. unschedulable cannot take an actor.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (ate_worker_state)(avg by (ate_workerpool_namespace, ate_workerpool_name, ate_sandbox_class, ate_worker_state)(ate_workerpool_workers))",
     "legendFormat": "{{ate_worker_state}}",
     "refId": "A"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 26,
    "w": 12,
    "h": 10
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 10,
      "lineWidth": 2,
      "showPoints": "never",
      "spanNulls": false,
      "axisSoftMin": 0,
      "stacking": {
       "mode": "normal"
      },
      "axisSoftMax": 4
     },
     "color": {
      "mode": "palette-classic"
     },
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "interval": "1m"
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "CPU of the actors, by atespace",
   "description": "CPU cores that the actor sandboxes use.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by (ate_template_atespace)(rate(ate_actor_stats_cpu_time_seconds_total{ate_template_atespace=~\"$atespace\"}[$__rate_interval]))",
     "legendFormat": "{{ate_template_atespace}}",
     "refId": "A"
    }
   ],
