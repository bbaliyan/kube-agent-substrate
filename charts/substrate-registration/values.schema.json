{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["substrate", "image", "actors"],
  "properties": {
    "snapshotStorageLocation": { "type": "string", "minLength": 1 },
    "actors": {
      "type": "array",
      "description": "The same list as the substrate-actor chart. That chart validates the full shape.",
      "items": {
        "type": "object",
        "required": ["name", "atespace"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 },
          "atespace": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 },
          "warm": { "type": "boolean" }
        }
      }
    },
    "accessBindings": {
      "type": "array",
      "description": "Roles to grant in an atespace. The Job adds the members to the binding of the role.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["atespace", "role", "members"],
        "properties": {
          "atespace": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 },
          "role": { "type": "string", "enum": ["viewer", "editor"], "description": "Never owner: the Job is a bootstrap owner, so an owner binding would hand out full control." },
          "members": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^user:\\S+$" }
          }
        }
      }
    },
    "substrate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace"],
      "properties": {
        "namespace": { "type": "string", "enum": ["ate-system"] }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Digest of the registration image. A tag alone is rejected."
        }
      }
    },
    "waitSeconds": { "type": "integer", "minimum": 1 },
    "backoffLimit": { "type": "integer", "minimum": 0 },
    "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
    "ttlSecondsAfterFinished": { "type": "integer", "minimum": 0 },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "annotations": { "type": "object" } }
    },
    "resources": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "name": { "type": "string" } }
    }
  }
}
