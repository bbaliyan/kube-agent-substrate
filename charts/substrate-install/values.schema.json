{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["substrate", "image", "config", "storage"],
  "properties": {
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "bucket", "region"],
      "properties": {
        "profile": { "type": "string", "enum": ["aws", "s3-compatible"] },
        "bucket": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$" },
        "region": { "type": "string", "minLength": 1 },
        "s3Compatible": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoint": { "type": "string" },
            "pathStyle": { "type": "boolean" },
            "credentials": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "secretName": { "type": "string" },
                "accessKeyKey": { "type": "string", "minLength": 1 },
                "secretKeyKey": { "type": "string", "minLength": 1 },
                "externalSecret": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "storeName": { "type": "string" },
                    "storeKind": { "type": "string", "enum": ["ClusterSecretStore", "SecretStore"] },
                    "refreshInterval": { "type": "string" },
                    "accessKeyRemoteKey": { "type": "string" },
                    "secretKeyRemoteKey": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "selinux": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requests", "limits"],
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cpu", "memory"],
              "properties": {
                "cpu": { "type": "string", "pattern": "^([1-9][0-9]*([.][0-9]+)?|0[.][0-9]*[1-9][0-9]*|[1-9][0-9]*m)$" },
                "memory": { "type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi)$" }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cpu", "memory"],
              "properties": {
                "cpu": { "type": "string", "pattern": "^([1-9][0-9]*([.][0-9]+)?|0[.][0-9]*[1-9][0-9]*|[1-9][0-9]*m)$" },
                "memory": { "type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi)$" }
              }
            }
          }
        },
        "storage": { "type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$" }
      }
    },
    "substrate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "imageRepository"],
      "properties": {
        "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$" },
        "imageRepository": { "type": "string", "minLength": 1 }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Digest of the install image. A tag alone is rejected."
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "description": "Body of the SubstrateInstall document. The chart owns images and sandboxClasses.",
      "properties": {
        "namespace": { "type": "string" },
        "gcp": { "type": "object" },
        "clusterSize": { "type": "string" },
        "rolloutTimeout": { "type": "string" },
        "atenet": { "type": "object" },
        "storage": {
          "type": "object",
          "properties": {
            "snapshotLocation": {
              "type": "string",
              "minLength": 1,
              "description": "Optional. The chart derives s3://<storage.bucket>/ and rejects a value outside that bucket."
            },
            "transferGSAName": { "type": "string" },
            "bucketName": { "type": "string" }
          }
        },
        "ingressAllowedSPIFFEIDs": { "type": "string" },
        "ateapi": { "type": "object" },
        "podcert": { "type": "object" },
        "actorJWT": { "type": "object" },
        "otlpEndpoint": { "type": "string" },
        "preview": { "type": "string" },
        "cordonSystemInfraComponents": { "type": "boolean" }
      }
    },
    "env": { "type": "array", "items": { "type": "object" } },
    "backoffLimit": { "type": "integer", "minimum": 0 },
    "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
    "resources": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "name": { "type": "string" } }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "clusterRole": { "type": "string", "minLength": 1 } }
    }
  }
}
