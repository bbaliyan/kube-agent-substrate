{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "labelSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matchLabels": { "type": "object", "additionalProperties": { "type": "string" } },
        "matchExpressions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "operator"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "operator": { "enum": ["In", "NotIn", "Exists", "DoesNotExist"] },
              "values": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "networkPolicyPeer": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "namespaceSelector": { "$ref": "#/definitions/labelSelector" },
        "podSelector": { "$ref": "#/definitions/labelSelector" },
        "ipBlock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cidr"],
          "properties": {
            "cidr": { "type": "string", "minLength": 1 },
            "except": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "digestImage": {
      "type": "string",
      "pattern": "^([a-z0-9.-]+(:[0-9]+)?/)?[a-z0-9._-]+(/[a-z0-9._-]+)*(:[A-Za-z0-9._-]+)?@sha256:[a-f0-9]{64}$",
      "description": "Image reference pinned by digest. A tag alone is rejected."
    },
    "dnsLabel": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 63
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "egressRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "hostnames"],
      "properties": {
        "protocol": { "enum": ["http", "https", "tlsPassthrough"] },
        "hostnames": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "ports": { "type": "array", "items": { "$ref": "#/definitions/port" } },
        "credential": {
          "type": "object",
          "additionalProperties": false,
          "required": ["header", "credentialUri"],
          "properties": {
            "header": { "type": "string", "minLength": 1 },
            "prefix": { "type": "string" },
            "credentialUri": { "type": "string", "pattern": "^ate-secret://.+" }
          }
        }
      }
    },
    "externalSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storeName", "data"],
      "properties": {
        "storeName": { "type": "string", "minLength": 1 },
        "storeKind": { "enum": ["ClusterSecretStore", "SecretStore"] },
        "data": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["secretKey", "remoteKey"],
            "properties": {
              "secretKey": { "type": "string", "minLength": 1 },
              "remoteKey": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "webhook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secret"],
      "properties": {
        "port": { "$ref": "#/definitions/port" },
        "hopToken": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{8,}$",
          "description": "The public value that the shim sends in X-Gitlab-Token to the actor. It is not the webhook secret."
        },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "description": "The time that the shim waits for the router, all tries together." },
        "perTryTimeoutSeconds": { "type": "integer", "minimum": 1, "description": "The time that one try waits for the router before the shim tries again." },
        "retries": { "type": "integer", "minimum": 0, "maximum": 5, "description": "How many times the shim tries again after a refused connection, a 502, a 503, a 504 or a try that ran out of time." },
        "keepWarmSeconds": { "type": "integer", "minimum": 0, "description": "The seconds between the keep-warm requests. 0 turns them off." },
        "keepWarmPath": { "type": "string", "pattern": "^/", "description": "The path of the keep-warm request to the actor. The actor must answer 200." },
        "keepWarmTimeoutSeconds": { "type": "integer", "minimum": 1, "description": "The time that a keep-warm request waits for the actor, for a cold start." },
        "resources": { "type": "object" },
        "allowFrom": {
          "type": "array",
          "minItems": 1,
          "description": "The from entries of a NetworkPolicy. With none, the chart renders no policy.",
          "items": { "$ref": "#/definitions/networkPolicyPeer" }
        },
        "secret": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "$ref": "#/definitions/dnsLabel" },
            "key": { "type": "string", "minLength": 1, "description": "The key of the Secret that holds the webhook secret. Default WEBHOOK_SECRET." },
            "externalSecret": { "$ref": "#/definitions/externalSecret" }
          }
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host"],
          "properties": {
            "className": { "type": "string" },
            "host": { "type": "string", "minLength": 1 },
            "path": { "type": "string" },
            "tlsSecretName": { "type": "string" },
            "annotations": { "$ref": "#/definitions/stringMap" }
          }
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "atespace", "image", "resources"],
      "properties": {
        "name": { "$ref": "#/definitions/dnsLabel" },
        "atespace": { "$ref": "#/definitions/dnsLabel" },
        "image": { "$ref": "#/definitions/digestImage" },
        "command": { "type": "array", "items": { "type": "string" } },
        "args": { "type": "array", "items": { "type": "string" } },
        "env": { "$ref": "#/definitions/stringMap" },
        "workerSelector": { "$ref": "#/definitions/stringMap" },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpuMillicores", "memoryBytes"],
          "properties": {
            "cpuMillicores": { "type": "integer", "minimum": 1 },
            "memoryBytes": { "type": "integer", "minimum": 1 }
          }
        },
        "wakeupProbe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "port"],
          "properties": {
            "path": { "type": "string" },
            "port": { "$ref": "#/definitions/port" },
            "timeoutSeconds": { "type": "integer", "minimum": 1 }
          }
        },
        "egress": { "type": "array", "items": { "$ref": "#/definitions/egressRule" } },
        "webhook": { "$ref": "#/definitions/webhook" }
      }
    }
  },
  "properties": {
    "snapshotStorageLocation": { "type": "string", "pattern": "^[a-z0-9]+://.+" },
    "webhookShimImage": { "$ref": "#/definitions/digestImage" },
    "router": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": { "type": "string", "minLength": 1, "description": "The name of the router Service. The shim checks it against the serving certificate." },
        "port": { "$ref": "#/definitions/port" }
      }
    },
    "actors": {
      "type": "array",
      "items": { "$ref": "#/definitions/actor" }
    }
  }
}
